{
    "name": "yananob/gmail-cleanup",
    "description": "Gmail 自動削除アプリ",
    "license": "proprietary",

    "require": {
        "php": ">= 8.2",
        "google/cloud-functions-framework": "^1.3",
        "google/cloud-firestore": "^2.3",
        "google/apiclient": "^2.0",
        "monolog/monolog": "^3.5",
        "nesbot/carbon": "^3.8",
        "eftec/bladeone": "^4.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "./tests/"
        }
    },
    "config": {
        "audit": {
            "ignore": [
                "PKSA-5jz8-6tcw-pbk4",
                "PKSA-z3gr-8qht-p93v"
            ]
        },
        "platform": {
            "php": "8.2"
        }
    }
}
